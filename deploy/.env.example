# /opt/wishme/.env  — owned by root, mode 600, never committed. Names only here; real values on the VPS.
# Every variable is validated at startup (src/config/env.ts); the process refuses to start on a bad value.

# ── Deployment ──────────────────────────────────────────────────────────────────────────────────────────────
IMAGE=ghcr.io/dhanuvagman006/wishmebackend
TAG=latest
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
API_REPLICAS=2

# ── Runtime ─────────────────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
PORT=3000
PUBLIC_URL=https://api.example.com
TRUST_PROXY_HOPS=1
# Origins allowed for browser clients (the native app sends no Origin). Comma separated, or empty.
CORS_ORIGINS=

# ── Database ────────────────────────────────────────────────────────────────────────────────────────────────
# shared     = the existing Supabase Postgres (transition; see docs/CUTOVER.md)
# standalone = the VPS Postgres after cutover (start it with: docker compose --profile standalone up -d postgres)
DB_MODE=shared
# Shared mode: Supabase "Session pooler" (port 5432) or direct connection string, with a dedicated role.
DATABASE_URL=
# LISTEN/NOTIFY for Realtime needs a session (not transaction-pooled) connection.
DATABASE_URL_DIRECT=
DB_SSL=require
DB_PREPARE=true
DB_POOL_MAX=15
DB_RLS_PASSTHROUGH=true
# Standalone mode only:
POSTGRES_USER=wishme
POSTGRES_PASSWORD=
POSTGRES_DB=wishme

# ── Redis ───────────────────────────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=wm

# ── Supabase (upstream for proxied routes, and the transition JWT secret) ──────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Project Settings → API → JWT Secret (legacy). Lets tokens issued here work on proxied Supabase routes too.
SUPABASE_JWT_SECRET=
# proxy until a group is tested; then override per group, e.g. {"auth":"local","rest":"local"}
COMPAT_DEFAULT_MODE=proxy
ROUTE_MODES={}

# ── Auth ────────────────────────────────────────────────────────────────────────────────────────────────────
JWT_SIGNING=supabase-hs256
# After cutover: JWT_SIGNING=eddsa and an Ed25519 PKCS8 key (openssl genpkey -algorithm ed25519)
JWT_PRIVATE_KEY=
JWT_KEY_ID=wm-1
# 32+ random bytes: openssl rand -base64 48
AUTH_PEPPER=
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_DAYS=60
PASSWORD_MIN_LENGTH=8
PASSWORD_BREACH_CHECK=true
ADMIN_USER_IDS=

# ── Email ───────────────────────────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_FROM=WishMe <no-reply@wishme.today>
RESEND_API_KEY=
SMTP_URL=

# ── Vendors (leave empty to disable the features that use them; they answer 503) ───────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=wishmetoday
B2_PUBLIC_BASE=https://f005.backblazeb2.com/file/wishmetoday
B2_PRIVATE_BUCKET=
GEMINI_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=
HEYGEN_API_KEY=
TBO_ENV=test
TBO_CLIENT_ID=
TBO_USERNAME=
TBO_PASSWORD=
TBO_HOTEL_USERNAME=
TBO_HOTEL_PASSWORD=
TBO_END_USER_IP=
SUNO_API_KEY=
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
WHATSAPP_PROVIDER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WELCOME_TEMPLATE=wishme_welcome
WHATSAPP_WELCOME_LANGUAGE=en

# ── Operations ──────────────────────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
METRICS_TOKEN=
APP_MIN_VERSION=1.0.0
APP_RECOMMENDED_VERSION=1.0.0
RATE_LIMIT_PER_MIN=300

# ── Backups (deploy/scripts/backup.sh) ──────────────────────────────────────────────────────────────────────
# age public key (age-keygen); the private key stays offline with the owner.
BACKUP_AGE_RECIPIENT=
# rclone remote and private bucket whose key can write but not delete, e.g. b2backup:wishme-db-backups
BACKUP_RCLONE_REMOTE=
