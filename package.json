{
  "name": "wishme-backend",
  "version": "0.1.0",
  "private": true,
  "description": "WishMe backend: Supabase-compatible gateway, clean /api/v1, workers. Runs on the owner's VPS.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx --env-file=.env src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "check": "pnpm run typecheck && pnpm run test:unit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/under-pressure": "^9.0.0",
    "@fastify/websocket": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.40.0",
    "fastify": "^5.3.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "jose": "^6.0.10",
    "nodemailer": "^6.10.0",
    "pino": "^9.6.0",
    "postgres": "^3.4.5",
    "prom-client": "^15.1.3",
    "undici": "^7.5.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "@types/ws": "^8.18.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
